{
  "ReverseProxy": {
    "Routes": {
      "admin-api": {
        "ClusterId": "admin-api",
        "Match": {
          "Path": "/admin/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/{**catch-all}"
          }
        ]
      },
      "project-api": {
        "ClusterId": "project-api",
        "Match": {
          "Path": "/project/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/{**catch-all}"
          }
        ]
      },
      "project-images": {
        "ClusterId": "project-api",
        "Match": {
          "Path": "/app/images/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "admin-api": {
        "Destinations": {
          "admin-api-http": {
            "Address": "http://localhost:5216/"
          }
        }
      },
      "project-api": {
        "Destinations": {
          "project-api-http": {
            "Address": "http://localhost:5033/"
          }
        }
      }
    }
  }
}
