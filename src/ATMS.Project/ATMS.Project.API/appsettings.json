{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "BusinessTimeZone": "Asia/Baku",
  "NotificationsOptions": {
    "DeadlineReminderTime": "09:00",
    "CleanupTime": "03:00",
    "ReadRetentionDays": 30,
    "RetentionDays": 90,
    "SendEmails": true
  },
  "JwtOptions": {
    "Issuer": "atms-services",
    "Audience": "http://localhost:5216",
    "TokenExpirationInMinutes": 25,
    "RefreshTokenExpirationInDays": 7,
    "EmailConfirmationTokenExpirationInHours": 24,
    "PasswordResetTokenExpirationInHours": 1,
    "MaxRefreshTokenLifetimeExpirationInDays": 90
  },
  "EmailOptions": {
    "From": "info.atms.org@gmail.com",
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "UserName": "ACS",
    "EnableSsl": true
  },
  "QueueOptions": {
    "Username": "admin",
    "Port": 5672,
    "VirtualHost": "atms"
  },
  "RedisOptions": {
    "InstanceName": "atms:project:"
  },
  "ImagesOptions": {
    "ImagesRootPath": "/app/images"
  },
  "AttachmentsOptions": {
    "RootPath": "/app/attachments",
    "MaxFileSizeBytes": 26214400,
    "MaxFilesPerOwner": 100
  },
  "AllowedHosts": "*"
}
