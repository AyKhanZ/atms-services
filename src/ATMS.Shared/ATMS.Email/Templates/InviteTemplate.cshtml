@model ATMS.Email.Models.InviteModel
@{
    var fullName = $"{Model.Name} {Model.Surname}".Trim();
    var greetingName = string.IsNullOrWhiteSpace(fullName) ? "there" : fullName;
    var deadline = Model.DeadlineOfToken.ToString("dd MMM yyyy, HH:mm");
    const string logoUrl = "https://baim.az/wp-content/uploads/2025/05/cropped-cropped-group-26.png";
}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>Confirm your account</title>
</head>
<body style="margin:0;padding:0;background:#fffaf3;color:#1f2937;font-family:Roboto,Arial,sans-serif;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;margin:0;padding:0;background:#fffaf3;">
    <tr>
      <td align="center" style="padding:42px 12px;background:#fffaf3;">
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:600px;max-width:100%;table-layout:fixed;background:#ffffff;margin:0 auto;border:1px solid #ececec;border-radius:8px;overflow:hidden;box-shadow:0 18px 46px rgba(31,41,55,0.10);">
          <tr>
            <td align="center" style="padding:32px 24px 24px;background:#ffffff;">
              <img src="@logoUrl" width="250" alt="BAIM" style="display:block;width:250px;max-width:72%;height:auto;border:0;outline:none;text-decoration:none;">
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:15px 24px;background:#ff8800;color:#ffffff;">
              <div style="font-family:Roboto,Arial,sans-serif;font-size:22px;line-height:28px;font-weight:800;">Welcome!</div>
            </td>
          </tr>
          <tr>
            <td style="padding:28px 34px 22px;background:#ffffff;">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="width:100%;background:#fffbf6;border:1px solid #ffe0b2;border-radius:8px;">
                <tr>
                  <td width="58" valign="top" style="width:58px;padding:18px 0 18px 18px;">
                    <div style="width:42px;height:42px;border-radius:50%;background:#ecfdf3;color:#22c55e;font-size:25px;line-height:42px;text-align:center;font-weight:400;">✓</div>
                  </td>
                  <td valign="top" style="padding:18px 18px 18px 0;color:#1f2937;">
                    <div style="font-size:16px;line-height:22px;font-weight:800;">Your account is ready</div>
                    <div style="margin-top:4px;font-size:13px;line-height:19px;color:#536176;">Confirm your email to activate access and start using BAIM.</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:0 34px 0;font-size:15px;line-height:22px;color:#1f2937;">
              <p style="margin:0 0 18px;">Hello @greetingName,</p>
              <p style="margin:0 0 18px;">Use the credentials below after confirming your email.</p>
              <p style="margin:0 0 10px;"><strong>Login:</strong> <a href="mailto:@Model.Email" style="color:#ff8800 !important;text-decoration:none !important;word-break:break-all;">@Model.Email</a></p>
              <p style="margin:0 0 20px;"><strong>Password:</strong> <span style="color:#ff8800;word-break:break-all;">@Model.Password</span></p>
              <p style="margin:0 0 18px;color:#536176;">This link is valid until <strong style="color:#1f2937;">@deadline</strong>.</p>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:10px 34px 28px;">
              <a href="@Model.Link" style="display:block;width:100%;max-width:340px;background:#ff8800;border-radius:50px;color:#ffffff;font-size:16px;line-height:44px;font-weight:700;text-align:center;text-decoration:none;">Confirm email</a>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:0 34px 34px;font-size:13px;line-height:20px;color:#64748b;">
              <p style="margin:0;">If the button does not work, open the <a href="@Model.Link" style="color:#f57c00;text-decoration:underline;">confirmation link</a>.</p>
            </td>
          </tr>
          <tr>
            <td style="padding:18px 34px 14px;background:#f6f6f6;border-top:1px solid #ececec;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;text-align:center;">
                <tr>
                  <td align="center" style="padding:0 0 10px;color:#536176;font-size:13px;line-height:18px;">
                    <div style="font-weight:700;color:#1f2937;">Business Automation & Innovation Center</div>
                    <div style="margin-top:3px;">Füzuli street 49, “Füzuli Residence” Business Center</div>
                    <div style="margin-top:12px;">
                      <span style="display:inline-block;width:14px;height:14px;margin-right:6px;vertical-align:-2px;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:block;">
                          <path d="M6.6 4.8 8.9 9c.3.5.2 1.1-.2 1.5l-1.1 1.1c1.3 2.4 2.9 4 5.3 5.3l1.1-1.1c.4-.4 1-.5 1.5-.2l4.2 2.3c.6.3.9 1 .7 1.7-.4 1.3-1.6 2.2-3 2.2C9.1 21.8 2.2 14.9 2.2 6.6c0-1.4.9-2.6 2.2-3 .7-.2 1.4.1 1.7.7l.5.5Z" stroke="#ff8800" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                      <a href="tel:+994555229966" style="color:#536176 !important;text-decoration:none !important;">+994555229966</a>
                    </div>
                    <div style="margin-top:3px;">
                      <span style="display:inline-block;width:14px;height:14px;margin-right:6px;vertical-align:-2px;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:block;">
                          <rect x="3.5" y="5.5" width="17" height="13" rx="2" stroke="#ff8800" stroke-width="2"/>
                          <path d="m5 8 7 5 7-5" stroke="#ff8800" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                      <a href="mailto:office@baim.az" style="color:#536176 !important;text-decoration:none !important;">office@baim.az</a>
                    </div>
                  </td>
                </tr>
              </table>
              <div style="height:1px;background:#ececec;line-height:1px;font-size:1px;">&nbsp;</div>
              <div style="padding:10px 0 0;text-align:center;color:#536176;font-size:12px;line-height:17px;">
                This is an automated email from BAIM.<br>
                Please do not reply to this message.
              </div>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
