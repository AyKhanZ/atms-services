{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "JwtOptions": {
    "Issuer": "atms-services",
    "Audience": "http://localhost:5216",
    "TokenExpirationInMinutes": 25,
    "RefreshTokenExpirationInDays": 7,
    "EmailConfirmationTokenExpirationInHours": 24,
    "PasswordResetTokenExpirationInHours": 1,
    "MaxRefreshTokenLifetimeExpirationInDays": 90
  },
  "EmailOptions": {
    "From": "info.atms.org@gmail.com",
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "UserName": "ACS",
    "EnableSsl": true
  },
  "QueueOptions": {
    "Username": "admin",
    "Port": 5672,
    "VirtualHost": "atms"
  },
  "RedisOptions": {
    "InstanceName": "atms:admin:"
  },
  "LocalizationOptions": {
    "DefaultLanguage": "en"
  },
  "AdminOptions": {
    "Name": "System",
    "Surname": "Administrator",
    "RoleName": "Super Admin"
  },
  "ImagesOptions": {
    "ImagesRootPath": "/app/images"
  },
  "ProviderOptions": {
    "TimeoutSeconds": 5
  },
  "RateLimitOptions": {
    "Enabled": true,
    "UserRequests": { "TokenLimit": 600, "TokensPerPeriod": 10, "PeriodSeconds": 1 },
    "IpRequests": { "TokenLimit": 200, "TokensPerPeriod": 4, "PeriodSeconds": 1 },
    "Mutations": { "TokenLimit": 120, "TokensPerPeriod": 2, "PeriodSeconds": 1 },
    "AuthLogin": { "PermitLimit": 30, "WindowSeconds": 60, "SegmentsPerWindow": 6 },
    "AuthRefresh": { "PermitLimit": 120, "WindowSeconds": 60, "SegmentsPerWindow": 6 },
    "AuthEmail": { "PermitLimit": 10, "WindowSeconds": 900 },
    "AuthToken": { "PermitLimit": 40, "WindowSeconds": 900 },
    "Creates": { "TokenLimit": 60, "TokensPerPeriod": 1, "PeriodSeconds": 1, "DailyLimit": 2000 },
    "Emails": { "TokenLimit": 20, "TokensPerPeriod": 1, "PeriodSeconds": 60, "DailyLimit": 100 },
    "Uploads": { "TokenLimit": 40, "TokensPerPeriod": 1, "PeriodSeconds": 2, "DailyLimit": 500 },
    "Downloads": { "PermitLimit": 10, "QueueLimit": 10 },
    "Heavy": { "PermitLimit": 8, "QueueLimit": 8 },
    "Migrations": { "PermitLimit": 1, "QueueLimit": 0 }
  },
  "AllowedHosts": "*"
}
